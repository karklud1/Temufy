<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <center>
        <VBox spacing="20" prefWidth="700" prefHeight="500">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="New song"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <GridPane hgap="15" vgap="20">

                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitle"
                           promptText="Song title"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Artist" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtArtist"
                           promptText="Artist name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Category" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbCategory"
                          prefWidth="300"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Time" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtTime"
                           promptText="3:41"
                           prefWidth="120"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="File" GridPane.columnIndex="0" GridPane.rowIndex="4"/>

                <HBox spacing="10"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="4">

                    <TextField fx:id="txtFile"
                               promptText="Choose song file..."
                               prefWidth="400"/>

                    <Button text="Choose..."
                            onAction="#handleChooseFile"/>
                </HBox>

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 15;">

            <Button text="Cancel"
                    onAction="#handleCancel"/>

            <Button text="Save"
                    onAction="#handleSave"/>
        </HBox>
    </bottom>

</BorderPane>