<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="220.0" prefWidth="420.0" styleClass="dialog-root" stylesheets="@CSS/theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.temufy.GUI.Controller.NewPlaylistController">
   <children>
      <VBox layoutX="24.0" layoutY="24.0" spacing="8.0">
         <children>
            <Label fx:id="lblPlaylist" styleClass="dialog-title" text="New playlist" />
            <Label styleClass="field-label" text="Name" />
            <TextField fx:id="txtName" prefHeight="30.0" prefWidth="360.0" promptText="My playlist" />
         </children>
      </VBox>
      <HBox layoutX="196.0" layoutY="168.0" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleClickCancel" prefHeight="26.0" prefWidth="80.0" styleClass="btn-secondary" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleClickSave" prefHeight="26.0" prefWidth="80.0" styleClass="btn-primary" text="Save" />
         </children>
         <padding>
            <Insets />
         </padding>
      </HBox>
   </children>
</AnchorPane>
